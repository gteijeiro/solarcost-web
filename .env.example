SA_COSTS_BRIDGE_URL=http://127.0.0.1:8765
SA_COSTS_BIND_HOST=127.0.0.1
SA_COSTS_BIND_PORT=8890
SA_COSTS_DB_PATH=./data/energy_costs.sqlite3
